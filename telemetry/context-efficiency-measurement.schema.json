{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Efficiency Measurement Record",
  "type": "object",
  "required": ["schema_version", "project", "story", "cohort", "standards_sha"],
  "properties": {
    "schema_version": {
      "enum": [1, 2],
      "description": "Context-efficiency measurement record schema version; independent of EFF telemetry record version v. Version 2 adds optional execution-profile, token, turn, and telemetry-health fields while preserving version 1 records."
    },
    "story": { "type": ["string", "null"] },
    "project": { "type": "string" },
    "attempt": { "type": ["integer", "null"], "minimum": 1 },
    "run_type": { "enum": ["Initial", "Correction", "Remediation", "Verification", null] },
    "agent_client": { "type": ["string", "null"] },
    "requested_model": { "type": ["string", "null"] },
    "requested_priority": { "type": ["string", "null"] },
    "runtime_model": { "type": ["string", "null"] },
    "runtime_priority": { "type": ["string", "null"] },
    "runtime_reasoning_configuration": { "type": ["string", "null"] },
    "execution_tier": { "enum": ["T0", "T1", "T2", "T3", null] },
    "execution_mode": { "enum": ["DIRECT", "PLAN", null] },
    "verification_scope": { "type": ["string", "null"], "description": "Declared bounded verification scope from the execution profile; not a claim that every listed check ran." },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "cohort": { "enum": ["BASELINE", "GRAPH", "GRAPH_CONTEXT_OPTIMIZATION"] },
    "files_inspected": { "type": ["integer", "null"], "minimum": 0 },
    "repeated_file_reads": { "type": ["integer", "null"], "minimum": 0 },
    "broad_search_calls": { "type": ["integer", "null"], "minimum": 0 },
    "graph_index_queries": { "type": ["integer", "null"], "minimum": 0 },
    "command_tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "raw_bytes_produced": { "type": ["integer", "null"], "minimum": 0 },
    "bytes_returned_to_model": { "type": ["integer", "null"], "minimum": 0 },
    "observed_bytes_context_avoided": { "type": ["integer", "null"], "minimum": 0 },
    "locally_estimated_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Directly observed runtime/provider input-token count only." },
    "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Directly observed runtime/provider reasoning-token count only." },
    "total_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Observed provider total or deterministic sum of non-overlapping observed components with provenance." },
    "locally_estimated_token_reduction": { "type": ["integer", "null"], "minimum": 0 },
    "provider_reported_token_usage": { "type": ["object", "null"] },
    "estimated_monetary_savings": { "type": ["number", "null"], "minimum": 0 },
    "expansion_retrieval_events": { "type": ["integer", "null"], "minimum": 0 },
    "elapsed_sec": { "type": ["number", "null"], "minimum": 0 },
    "retries": { "type": ["integer", "null"], "minimum": 0 },
    "mechanical_retries": { "type": ["integer", "null"], "minimum": 0 },
    "agent_turns": { "type": ["integer", "null"], "minimum": 0 },
    "subagent_turns": { "type": ["integer", "null"], "minimum": 0 },
    "test_outcome": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN", "NOT APPLICABLE", null] },
    "acceptance_result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN", null] },
    "correctness_result": { "enum": ["PASS", "FAIL", "PARTIAL", "UNKNOWN", null] },
    "human_rework_required": { "type": ["boolean", "null"] },
    "human_corrections": { "type": ["integer", "null"], "minimum": 0 },
    "base_sha": { "type": ["string", "null"] },
    "final_sha": { "type": ["string", "null"] },
    "files_changed": { "type": ["integer", "null"], "minimum": 0 },
    "insertions": { "type": ["integer", "null"], "minimum": 0 },
    "deletions": { "type": ["integer", "null"], "minimum": 0 },
    "unrelated_files": { "type": ["integer", "null"], "minimum": 0 },
    "verification_outcome": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN", "NOT APPLICABLE", null] },
    "verification_failures": { "type": ["integer", "null"], "minimum": 0 },
    "compliance": { "enum": ["PASS", "FAIL", "PARTIAL", "NOT AVAILABLE", null] },
    "commit_sha": { "type": ["string", "null"] },
    "push": { "enum": ["PASS", "FAIL", "NA", null] },
    "blocker": { "type": ["string", "null"] },
    "standards_sha": { "type": "string" },
    "telemetry_health": { "enum": ["HEALTHY", "DEGRADED", "NOT ASSESSED", null] },
    "field_availability": {
      "type": ["object", "null"],
      "description": "Per-field evidence class for values material to the analysis. A missing field is not zero.",
      "additionalProperties": { "enum": ["OBSERVED", "DERIVED", "NOT AVAILABLE"] }
    },
    "telemetry_degradation": {
      "type": ["object", "null"],
      "properties": {
        "affected_fields": { "type": "array", "items": { "type": "string" } },
        "last_known_good": { "type": ["string", "null"] },
        "raw_evidence_ref": { "type": ["string", "null"] },
        "suspected_change": { "type": ["string", "null"] }
      },
      "required": ["affected_fields"],
      "additionalProperties": false
    },
    "source_provenance": { "type": ["object", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
